  "fieldContract": {
    "identity": "Exact numeric pair when structurally well formed, null otherwise. A duplicate may retain its exact pair but remains ambiguous.",
    "identityWellFormed": "Numeric JSON integer IDs, neither boolean nor string; aliases consistent. This does not imply uniqueness.",
    "receivedAtMs": "Exact source observation timestamp when included; absent expectations do not authorize synthesizing one.",
    "recordedInferenceConsistent": "Unique, structurally valid recorded inference with matching frame identity and source clock. Independent of PNG availability; an app may block rendering/replay for a missing/unsafe PNG.",
    "detectionClassIds": "Ordered classes of a consistent recorded inference; optional when no such inference is attributable.",
    "issueKinds": "Semantic causes required somewhere in inspection (entry or global diagnostics), not exact translated message strings.",
    "imagePath": "Exact recorded value, including malicious fixture strings; never permission to read outside capture."
  }
